{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@resqsync/domain": ["../../packages/domain/src/index.ts"],
      "@resqsync/contracts": ["../../packages/contracts/src/index.ts"],
      "@resqsync/ui": ["../../packages/ui/src/index.ts"],
      "@resqsync/offline": ["../../packages/offline/src/index.ts"]
    }
  },
  "include": ["src"]
}
