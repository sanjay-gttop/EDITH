{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*",
    "apps/*/src/**/*",
    "services/*/src/**/*",
    "infra/*/lib/**/*",
    "infra/*/bin/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "cdk.out"
  ]
}
